# このファイルを .env.local にコピーして値を入れる（.env.local は git に入らない）

# AI校正（Gemini API）。https://aistudio.google.com/apikey で無料で発行できる
# 無料枠では、送った文章が Google のサービス改善に使われることがある
GEMINI_API_KEY=

# 使うモデル。空欄なら gemini-3.5-flash。無料枠の対象モデルは変わるので、料金ページで確認する
GEMINI_MODEL=

# 公開サイトの URL（末尾スラッシュなし）。本番のビルドでは必須（シェア画像・サイトマップの絶対 URL に使う）
NEXT_PUBLIC_SITE_URL=

# デモ版の帯を消すときは 0（決済とデータベースをつないだら）
NEXT_PUBLIC_DEMO=

# Stripe（決済）。テストモードのシークレットキー（sk_test_…）を入れると、支援とメンバーシップが Stripe の決済ページにつながる
# 手順は docs/stripe-test.md。本番のキー（sk_live_…）は、Stripe の審査が通るまで使わない
STRIPE_SECRET_KEY=

# 本番のキー（sk_live_…）で決済を動かすときだけ 1。審査が通り、本番の仕組み（データベース・Webhook）がそろうまでは空のまま
STRIPE_ALLOW_LIVE=

# Stripe の Webhook の署名の秘密（whsec_…）。Stripe のダッシュボード、または `stripe listen` で表示される
# 受け口は /api/stripe/webhook。決済の確定・コンビニ払いの入金・返金・失敗をここで受け取る
STRIPE_WEBHOOK_SECRET=

# メールの送信（Resend）。空欄なら送らずにログだけ残す。https://resend.com でキーを発行し、送信元のドメインを認証する
RESEND_API_KEY=
# 送信元（例: Oto Fund <no-reply@otofund.example>）
EMAIL_FROM=

# Supabase（データベース・ログイン・画像の保存）。つなぐときに使う。手順は docs/production-setup.md
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# サーバーだけで使う（Webhook から記録するときなど）。絶対にブラウザに出さない・NEXT_PUBLIC_ を付けない
SUPABASE_SERVICE_ROLE_KEY=
